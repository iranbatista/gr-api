# Copie para .env e preencha. NUNCA versione o .env.
# ---- Ingestao (sync.py) ----
GYMRATS_TOKEN=cole_aqui_o_jwt_extraido_do_app
GYMRATS_BASE_URL=https://www.gymrats.app/api
# ---- Export opcional p/ Google Sheets (sync.py) ----
# Deixe em branco para desligar. Precisa dos DOIS para ligar. Ver DEPLOY.md.
GYMRATS_SHEETS_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gsa.json
# ---- API (api.py) ----
GYMRATS_API_KEY=gere_uma_chave_longa_aleatoria
GYMRATS_CORS=https://seuapp.com,https://www.seuapp.com
# GYMRATS_DB: so para rodar local. No Docker e fixo em /data/gymrats.db (Dockerfile).
# Fuso para agrupar check-ins por dia em /stats (default America/Sao_Paulo).
# GYMRATS_TZ=America/Sao_Paulo
